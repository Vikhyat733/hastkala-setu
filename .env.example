# MELA Environment Configuration Example
# Copy this file to .env and adjust values for your local or production environment.

# ==========================================
# General App Configuration
# ==========================================
ENVIRONMENT=development
DEBUG=True
APP_NAME="MELA API"
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# ==========================================
# Server Configuration
# ==========================================
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5000"]

# ==========================================
# Security & Authentication
# ==========================================
# Generate a strong 64+ char secret in production: openssl rand -hex 32
SECRET_KEY=dev_secret_key_change_in_production_mela_sih_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://mela_user:mela_password@localhost:5432/mela_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==========================================
# AI Model & Service Keys (Modular)
# ==========================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
SPEECH_MODEL_PROVIDER=whisper
TRANSLATION_SERVICE_KEY=your_translation_key_here

# ==========================================
# Payment Gateway Configuration (Isolated)
# ==========================================
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==========================================
# Frontend Configuration (mela_app)
# ==========================================
MELA_API_BASE_URL=http://localhost:8000/api/v1
DEFAULT_LOCALE=hi
ENABLE_VOICE_ASSISTANT=True
